# Market-data settings for the optional Vercel functions in api/.
# Production: set these in Vercel > Project > Settings > Environment Variables
# (then redeploy). Local `vercel dev`: copy this file to .env (git-ignored).
# Never commit real values. See docs/MARKET_DATA.md.

# Which provider /api/quotes and /api/history use: dhan | sheet | none  (empty = none)
MARKET_DATA_PROVIDER=

# DhanHQ v2 (needs a Dhan account with an active Data API plan)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Your own Google Sheet: Apps Script web app /exec URL + a read-only shared secret
SHEET_FEED_URL=
SHEET_FEED_TOKEN=
