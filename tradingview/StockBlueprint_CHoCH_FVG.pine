//@version=5
// Stock Blueprint - CHoCH + FVG (discount): the Backtest Lab's rules drawn on the TradingView chart.
// Owner, 11-Nov-2026: "i open trading view chart and i go to that trade date. i check how our backtest enter the trade,
// how our backtest where it is marked Choch, FVG ... it would be helpful if i got pinescript indicator".
// The same rules as the laptop (pcbridge/ScreenerBridge/structure.py, kite_intraday.py, backtest_lab.py):
//  - swing high / low = a candle above / below the N candles on both sides (known - and drawn - N candles later)
//  - CHoCH = the first candle that CLOSES above the last swing high after at least M lower highs AND M lower lows
//  - the move = from the CHoCH's final low (the lowest low between that swing high and the CHoCH candle) to the highest high since
//  - BOS = after the CHoCH, the first close above the highest swing high confirmed after it; a close under the final low ends the CHoCH
//  - zones: 3-candle FVG (gap >= 0.70 x the 14-candle average range), Gap-up zones (3 - 5 %, or any size between two big green candles = inside FVG)
//  - BUY = the FIRST time price comes back to a zone that formed after the final low, on the first pullback (no BOS yet),
//    with the zone's middle at least 50 % down the move (the discount); one BUY a candle (the zone price reaches first)
// Kept in step with tradingview/pine_model.py - tests/tradingview-pine.test.js checks that model against the laptop's code.
indicator("Stock Blueprint - CHoCH + FVG", shorttitle="SB CHoCH+FVG", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=5000)

// ------------------------------------------------------------------ inputs (= the Backtest Lab's defaults)
G1 = "Market structure (Backtest Lab step 2)"
pivN = input.int(5, "A swing: candles each side", minval=2, maxval=20, group=G1)
downN = input.int(3, "Lower highs and lower lows before the CHoCH, at least", minval=1, maxval=8, group=G1)
zoneWhen = input.string("In the CHoCH move or after it", "The zone formed", options=["In the CHoCH move or after it", "Only in the CHoCH move", "Only after the CHoCH candle"], group=G1)
fibLvl = input.float(0.5, "Discount: the zone at least this far down the move (0 = off)", options=[0.0, 0.382, 0.5, 0.618, 0.705, 0.786], group=G1)
discPart = input.string("Middle", "... judged on the zone's", options=["Middle", "Top", "Bottom"], group=G1)
firstPull = input.bool(true, "First pullback only (no BOS yet)", group=G1)
belowChoch = input.bool(false, "Zone top below the CHoCH level (strict)", group=G1)
G2 = "Entry, stop, target (drawn at each BUY)"
entryMode = input.string("Order at the zone top", "Buy", options=["Order at the zone top", "Touch candle's close"], group=G2)
stopBuf = input.float(0.5, "Stop: % under the zone bottom", minval=0, step=0.1, group=G2)
targetR = input.float(2.0, "Target (R = times the risk)", minval=0.25, step=0.25, group=G2)
G3 = "Zones"
fvgK = input.float(0.70, "FVG: gap at least x the 14-candle average range", minval=0, step=0.05, group=G3)
gapMin = input.float(3.0, "Gap-up zone: gap at least %", minval=0, step=0.5, group=G3)
gapMax = input.float(5.0, "Gap-up zone: gap at most %", minval=0, step=0.5, group=G3)
insideBody = input.float(2.0, "Inside FVG: both green candles' body at least % of the open", minval=0, step=0.5, group=G3)
G4 = "Spring (the pattern's own rule)"
spBody = input.float(0.5, "Red candle: body at least % of its open", minval=0, step=0.1, group=G4)
spUnder = input.float(0.10, "Spring low at least % under the red candle's low", minval=0, step=0.05, group=G4)
spBodyMax = input.float(30.0, "Spring body under % of the red candle's body", minval=1, step=1, group=G4)
spReclaim = input.float(50.0, "Spring high at most % of the red candle's range above its low", minval=1, step=5, group=G4)
sp1315 = input.bool(true, "4H chart: Springs only on the 13:15 candle", group=G4)
G5 = "Show"
showSwings = input.bool(true, "Swing highs / lows", group=G5)
showZones = input.bool(true, "Zones of the CHoCH move (while price has not come back)", group=G5)
showAll = input.bool(false, "Every FVG / Gap-up zone", group=G5)
showSpring = input.bool(true, "Spring candles (S)", group=G5)
showTable = input.bool(true, "Summary table (the current CHoCH)", group=G5)
markOn = input.bool(false, "Mark a trade date", group=G5)
markDate = input.time(timestamp("01 Jan 2026 00:00 +0530"), "Trade date (from the Backtest Lab)", group=G5)

C_CHOCH = #b388ff
C_FIB = #ffd166
C_BUY = #00c853
C_STOP = #ff5252
C_TGT = #448aff
C_FVG = #26a69a
C_GAP = #ab47bc
C_SW = #ffb74d
TZ = "Asia/Kolkata"

// ------------------------------------------------------------------ helpers
pivotHigh(int n) =>
    bool ok = bar_index >= 2 * n
    if ok
        float x = high[n]
        for k = 1 to n
            if not (x > high[n + k] and x >= high[n - k])
                ok := false
                break
    ok

pivotLow(int n) =>
    bool ok = bar_index >= 2 * n
    if ok
        float y = low[n]
        for k = 1 to n
            if not (y < low[n + k] and y <= low[n - k])
                ok := false
                break
    ok

isLocked(float h, float l) =>
    l > 0 and (h - l) / l * 100 <= 0.05

bigGreen(float o, float c) =>
    o > 0 and c > o and (c - o) / o * 100 >= insideBody

two(int v) =>
    (v < 10 ? "0" : "") + str.tostring(v)

fmtT(int t) =>
    string s = str.tostring(year(t, TZ)) + "-" + two(month(t, TZ)) + "-" + two(dayofmonth(t, TZ))
    timeframe.isintraday ? s + " " + two(hour(t, TZ)) + ":" + two(minute(t, TZ)) : s

fmtP(float v) =>
    str.tostring(v, format.mintick)

// ------------------------------------------------------------------ every bar
bool ph = pivotHigh(pivN)
bool pl = pivotLow(pivN)
bool lockNow = isLocked(high, low)
bool lockPrev = bar_index >= 1 and isLocked(high[1], low[1])
bool gapAny = bar_index >= 1 and not lockNow and not lockPrev and high[1] > 0 and low > high[1]
float gapPct = gapAny ? (low - high[1]) / high[1] * 100 : na
float avgRange = ta.sma(high - low, 14)

// swings (alternating: a second high before a low keeps the higher one) and the CHoCH state
var swP = array.new_int()
var swV = array.new_float()
var swH = array.new_bool()
var int lastUsedHi = -1
var int segHi = -1
var float segMin = na
var int segMinBar = -1
var int chB = -1
var int chHi = -1
var float chLvl = na
var int chLi = -1
var float chLf = na
var int chD = 0
var bool chDead = true
var int chBos = -1
var float chPeak = na
var int chPeakBar = -1
var float chH = na
var int chTime = 0
var int chLiTime = 0
var line fibLn = na
var label fibLb = na
var int nBuys = 0
var string lastBuy = "-"
// zones not touched yet
var zF = array.new_int()
var zBot = array.new_float()
var zTop = array.new_float()
var zGap = array.new_bool()
var zIn = array.new_bool()
var zBox = array.new_box()
var hitList = array.new_int()

// 1. a close under the final low ends the CHoCH (this candle too)
bool alive = chB >= 0 and not chDead and chB < bar_index
if alive and close < chLf
    chDead := true
    alive := false
    label.new(bar_index, low, "CHoCH ended", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.gray, 30), textcolor=color.white, size=size.tiny, tooltip="A close under the CHoCH's final low " + fmtP(chLf) + " - no more setups from this CHoCH")

// 2. the zones this candle touches for the first time (low <= zone top; a Gap-up zone never on a circuit-locked candle)
array.clear(hitList)
int best = -1
int nz = array.size(zF)
if nz > 0
    for k = 0 to nz - 1
        float zt = array.get(zTop, k)
        bool zg = array.get(zGap, k)
        if low <= zt and (not zg or not lockNow)
            array.push(hitList, k)
            if alive
                int f = array.get(zF, k)
                float zb = array.get(zBot, k)
                bool ok = f >= chLi
                if zoneWhen == "Only in the CHoCH move" and f > chB + 1
                    ok := false
                if zoneWhen == "Only after the CHoCH candle" and f <= chB
                    ok := false
                if firstPull and chBos >= 0
                    ok := false
                if belowChoch and not (zt < chLvl)
                    ok := false
                if fibLvl > 0
                    float part = discPart == "Top" ? zt : discPart == "Bottom" ? zb : (zb + zt) / 2
                    float dep = chH > chLf ? (chH - part) / (chH - chLf) : na
                    if na(dep) or dep < fibLvl - 0.000000001
                        ok := false
                if ok
                    if best < 0
                        best := k
                    else
                        float bt = array.get(zTop, best)
                        bool bg = array.get(zGap, best)
                        bool before = zt > bt or (zt == bt and not zg and bg) or (zt == bt and zg == bg and f < array.get(zF, best))
                        if before
                            best := k

if best >= 0
    float zb = array.get(zBot, best)
    float zt = array.get(zTop, best)
    int f = array.get(zF, best)
    bool isGap = array.get(zGap, best)
    string kind = isGap ? (array.get(zIn, best) ? "Gap-up zone (inside FVG)" : "Gap-up zone") : "FVG"
    float part = discPart == "Top" ? zt : discPart == "Bottom" ? zb : (zb + zt) / 2
    float dep = chH > chLf ? (chH - part) / (chH - chLf) : na
    float entry = entryMode == "Order at the zone top" ? math.min(open, zt) : close
    float stop = zb * (1 - stopBuf / 100)
    float risk = entry - stop
    string tip = "CHoCH " + fmtP(chLvl) + " on " + fmtT(chTime) + " (" + str.tostring(chD) + " lower highs / lows, final low " + fmtP(chLf) + " on " + fmtT(chLiTime) + ")\nmove high " + fmtP(chH) + "\n" + kind + " " + fmtP(zb) + " - " + fmtP(zt) + (na(dep) ? "" : ", its " + str.lower(discPart) + " " + str.tostring(math.round(dep * 100)) + "% down the move") + (fibLvl > 0 ? " (" + str.tostring(fibLvl * 100) + "% line " + fmtP(chH - fibLvl * (chH - chLf)) + ")" : "")
    if risk > 0
        float tgt = entry + targetR * risk
        nBuys += 1
        lastBuy := fmtT(time) + " at " + fmtP(entry)
        tip := tip + "\nentry " + fmtP(entry) + " · stop " + fmtP(stop) + " · target " + fmtP(tgt) + " (" + str.tostring(targetR) + "R) · risk " + str.tostring(math.round(risk / entry * 1000) / 10.0) + "%"
        label.new(bar_index, low, "BUY " + fmtP(entry), yloc=yloc.belowbar, style=label.style_label_up, color=C_BUY, textcolor=color.white, size=size.small, tooltip=tip)
        line.new(bar_index, entry, bar_index + 8, entry, color=C_BUY, width=2)
        line.new(bar_index, stop, bar_index + 8, stop, color=C_STOP, width=2)
        line.new(bar_index, tgt, bar_index + 8, tgt, color=C_TGT, width=2, style=line.style_dashed)
    else
        label.new(bar_index, low, "gap", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.gray, 20), textcolor=color.white, size=size.tiny, tooltip=tip + "\nopened under the stop - no trade")
    box bxb = array.get(zBox, best)
    if na(bxb)
        box.new(isGap ? f - 1 : f - 2, zt, bar_index, zb, border_color=C_BUY, bgcolor=color.new(C_BUY, 80), text=(fibLvl > 0 ? "discount " : "") + kind, text_size=size.tiny, text_color=C_BUY, text_halign=text.align_left, text_valign=text.align_top)
    else
        box.set_bgcolor(bxb, color.new(C_BUY, 80))
        box.set_border_color(bxb, C_BUY)
        box.set_text(bxb, (fibLvl > 0 ? "discount " : "") + kind)
        box.set_text_color(bxb, C_BUY)
        box.set_text_size(bxb, size.tiny)

// touched zones leave the list (their box stops at this candle; grey = touched, not a setup)
int nh = array.size(hitList)
if nh > 0
    for j = nh - 1 to 0
        int k = array.get(hitList, j)
        box bx = array.get(zBox, k)
        if not na(bx)
            box.set_right(bx, bar_index)
            box.set_extend(bx, extend.none)
            if k != best
                box.set_bgcolor(bx, color.new(color.gray, 88))
                box.set_border_color(bx, color.new(color.gray, 55))
        array.remove(zF, k)
        array.remove(zBot, k)
        array.remove(zTop, k)
        array.remove(zGap, k)
        array.remove(zIn, k)
        array.remove(zBox, k)

// 3. BOS: a swing high confirmed now (after the CHoCH candle) raises the peak; a close above the peak = BOS
if chB >= 0 and not chDead and chBos < 0 and bar_index > chB
    int p3 = bar_index - pivN
    if ph and p3 > chB and (na(chPeak) or high[pivN] > chPeak)
        chPeak := high[pivN]
        chPeakBar := p3
    if not na(chPeak) and close > chPeak
        chBos := bar_index
        line.new(chPeakBar, chPeak, bar_index, chPeak, color=C_STOP, width=1)
        label.new(bar_index, chPeak, "BOS", style=label.style_label_down, color=color.new(C_STOP, 10), textcolor=color.white, size=size.tiny, tooltip="Break of structure: a close above the highest swing high " + fmtP(chPeak) + " since the CHoCH - price already moved; later touches are not the first pullback")

// 4. the move's high (the next candles' discount line)
if chB >= 0 and not chDead and bar_index > chB
    chH := math.max(chH, high)
if chB >= 0 and not chDead and fibLvl > 0 and not na(fibLn)
    float fpx = chH - fibLvl * (chH - chLf)
    line.set_y1(fibLn, fpx)
    line.set_xy2(fibLn, bar_index, fpx)
    label.set_xy(fibLb, bar_index, fpx)
    label.set_text(fibLb, str.tostring(fibLvl * 100) + "% " + fmtP(fpx))

// 5. new zones: a 3-candle FVG on this candle, a Gap-up zone 3 - 5 % on this candle, the candle before's gap between two big
//    green candles (inside FVG - judged now that the next candle closed)
bool zoneBoxOn = showAll or (showZones and chB >= 0 and not chDead)
if bar_index >= 13 and low > high[2] and (low - high[2]) >= fvgK * avgRange
    array.push(zF, bar_index)
    array.push(zBot, high[2])
    array.push(zTop, low)
    array.push(zGap, false)
    array.push(zIn, false)
    box nb1 = na
    if zoneBoxOn and (showAll or bar_index >= chLi)
        nb1 := box.new(bar_index - 2, low, bar_index, high[2], border_color=color.new(C_FVG, 40), bgcolor=color.new(C_FVG, 88), extend=extend.right)
    array.push(zBox, nb1)
if gapAny and gapPct >= gapMin and gapPct <= gapMax
    array.push(zF, bar_index)
    array.push(zBot, high[1])
    array.push(zTop, low)
    array.push(zGap, true)
    array.push(zIn, false)
    box nb2 = na
    if zoneBoxOn and (showAll or bar_index >= chLi)
        nb2 := box.new(bar_index - 1, low, bar_index, high[1], border_color=color.new(C_GAP, 40), bgcolor=color.new(C_GAP, 88), extend=extend.right)
    array.push(zBox, nb2)
if bar_index >= 3 and gapAny[1] and gapPct[1] <= gapMax
    if bigGreen(open[2], close[2]) and bigGreen(open[1], close[1]) and low[1] > high[2] and high[3] < high[2] and low > low[1]
        if gapPct[1] >= gapMin
            int nz5 = array.size(zF)
            if nz5 > 0
                for k = 0 to nz5 - 1
                    if array.get(zF, k) == bar_index - 1 and array.get(zGap, k)
                        array.set(zIn, k, true)
        else
            array.push(zF, bar_index - 1)
            array.push(zBot, high[2])
            array.push(zTop, low[1])
            array.push(zGap, true)
            array.push(zIn, true)
            box nb3 = na
            if zoneBoxOn and (showAll or bar_index - 1 >= chLi)
                nb3 := box.new(bar_index - 2, low[1], bar_index, high[2], border_color=color.new(C_GAP, 40), bgcolor=color.new(C_GAP, 88), extend=extend.right)
            array.push(zBox, nb3)
// the oldest untouched zones go (they formed long before any CHoCH that could use them)
if array.size(zF) > 300
    box old = array.shift(zBox)
    if not na(old)
        box.delete(old)
    array.shift(zF)
    array.shift(zBot)
    array.shift(zTop)
    array.shift(zGap)
    array.shift(zIn)

// 6. swings (confirmed pivN candles later) and the CHoCH (a close above the last swing high)
int p = bar_index - pivN
if p >= pivN and ph != pl
    float v = ph ? high[pivN] : low[pivN]
    int sz = array.size(swP)
    bool same = false
    if sz > 0
        same := array.get(swH, sz - 1) == ph
    if same
        float lastV = array.get(swV, sz - 1)
        if (ph and v > lastV) or (not ph and v < lastV)
            array.set(swP, sz - 1, p)
            array.set(swV, sz - 1, v)
    else
        array.push(swP, p)
        array.push(swV, v)
        array.push(swH, ph)
int sz6 = array.size(swP)
if sz6 > 0
    int q = array.get(swH, sz6 - 1) ? sz6 - 1 : sz6 - 2
    if q >= 0
        int hiBar = array.get(swP, q)
        float lvl = array.get(swV, q)
        if hiBar != segHi
            segHi := hiBar
            segMin := na
            segMinBar := -1
            int span = bar_index - hiBar
            if span > 0
                for k = 1 to span
                    int off = span - k
                    if na(segMin) or low[off] < segMin
                        segMin := low[off]
                        segMinBar := bar_index - off
        else if low < segMin
            segMin := low
            segMinBar := bar_index
        if close > lvl and hiBar > lastUsedHi
            lastUsedHi := hiBar
            int dh = 0
            int kk = q
            bool more = true
            while more
                if kk - 2 >= 0
                    if array.get(swV, kk) < array.get(swV, kk - 2)
                        dh += 1
                        kk -= 2
                    else
                        more := false
                else
                    more := false
            int dl = 0
            float prevLow = segMin
            kk := q - 1
            more := true
            while more
                if kk >= 0
                    if prevLow < array.get(swV, kk)
                        dl += 1
                        prevLow := array.get(swV, kk)
                        kk -= 2
                    else
                        more := false
                else
                    more := false
            int d = math.min(dh, dl)
            if d >= downN
                chB := bar_index
                chHi := hiBar
                chLvl := lvl
                chLi := segMinBar
                chLf := segMin
                chD := d
                chDead := false
                chBos := -1
                chPeak := na
                chPeakBar := -1
                chTime := time
                chLiTime := time[bar_index - segMinBar]
                float mh = na
                int span2 = bar_index - chLi
                for k = 0 to span2
                    mh := na(mh) ? high[k] : math.max(mh, high[k])
                chH := mh
                line.new(chHi, chLvl, bar_index, chLvl, color=C_CHOCH, width=2, style=line.style_dashed)
                label.new(bar_index, chLvl, "CHoCH (" + str.tostring(d) + ")", style=label.style_label_down, color=color.new(C_CHOCH, 10), textcolor=color.white, size=size.small, tooltip="CHoCH " + fmtP(chLvl) + " on " + fmtT(time) + ": a close above the last swing high after " + str.tostring(d) + " lower highs and lower lows. Final low " + fmtP(chLf) + " on " + fmtT(chLiTime))
                label.new(chLi, chLf, "final low", yloc=yloc.price, style=label.style_label_up, color=color.new(C_CHOCH, 40), textcolor=color.white, size=size.tiny)
                if fibLvl > 0
                    float fp0 = chH - fibLvl * (chH - chLf)
                    fibLn := line.new(chLi, fp0, bar_index, fp0, color=C_FIB, width=1, style=line.style_dotted)
                    fibLb := label.new(bar_index, fp0, str.tostring(fibLvl * 100) + "% " + fmtP(fp0), style=label.style_label_left, color=color.new(C_FIB, 100), textcolor=C_FIB, size=size.tiny)
                // the zones of this move that wait for price (formed after the final low, not touched yet)
                if showZones and not showAll
                    int nz6 = array.size(zF)
                    if nz6 > 0
                        for k = 0 to nz6 - 1
                            int ff = array.get(zF, k)
                            if ff >= chLi and na(array.get(zBox, k))
                                bool g6 = array.get(zGap, k)
                                array.set(zBox, k, box.new(g6 ? ff - 1 : ff - 2, array.get(zTop, k), bar_index, array.get(zBot, k), border_color=color.new(g6 ? C_GAP : C_FVG, 40), bgcolor=color.new(g6 ? C_GAP : C_FVG, 88), extend=extend.right))

// ------------------------------------------------------------------ marks
float c1Body = math.abs(close[1] - open[1])
bool spring = bar_index >= 3 and close[1] < open[1] and c1Body / open[1] >= spBody / 100 and low < low[1] and close > low[1] and math.abs(close - open) < spBodyMax / 100 * c1Body and low <= low[1] * (1 - spUnder / 100) and high <= low[1] + spReclaim / 100 * (high[1] - low[1])
bool slotOk = not sp1315 or timeframe.period != "240" or (hour(time, TZ) == 13 and minute(time, TZ) == 15)
plotshape(showSpring and spring and slotOk, "Spring", shape.triangleup, location.belowbar, color.new(#26c6da, 0), size=size.tiny, text="S", textcolor=color.new(#26c6da, 0))
plotshape(showSwings and ph, "Swing high", shape.circle, location.abovebar, color.new(C_SW, 0), offset=-pivN, size=size.tiny)
plotshape(showSwings and pl, "Swing low", shape.circle, location.belowbar, color.new(C_SW, 0), offset=-pivN, size=size.tiny)
bool marked = markOn and year(time, TZ) == year(markDate, TZ) and month(time, TZ) == month(markDate, TZ) and dayofmonth(time, TZ) == dayofmonth(markDate, TZ)
bgcolor(marked ? color.new(#ffd600, 75) : na, title="Trade date")

var table tb = table.new(position.top_right, 2, 7, bgcolor=color.new(#0f172a, 15), border_color=color.new(#334155, 0), border_width=1, frame_color=color.new(#334155, 0), frame_width=1)
if showTable and barstate.islast
    string stTxt = chB < 0 ? "no CHoCH yet" : chDead ? "ended (a close under the final low)" : chBos >= 0 ? "after a BOS - no first-pullback BUY now" : "alive - waiting for price to come back to a discount zone"
    table.cell(tb, 0, 0, "Stock Blueprint", text_color=C_FIB, text_size=size.small)
    table.cell(tb, 1, 0, "CHoCH + FVG (" + str.tostring(pivN) + " / " + str.tostring(downN) + ")", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 1, "CHoCH", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 1, chB < 0 ? "-" : fmtP(chLvl) + " on " + fmtT(chTime) + " (" + str.tostring(chD) + " lower highs / lows)", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 2, "Final low", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 2, chB < 0 ? "-" : fmtP(chLf) + " on " + fmtT(chLiTime), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 3, "Move high", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 3, chB < 0 ? "-" : fmtP(chH), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 4, str.tostring(fibLvl * 100) + "% line", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 4, chB < 0 or fibLvl <= 0 ? "-" : fmtP(chH - fibLvl * (chH - chLf)), text_color=C_FIB, text_size=size.small)
    table.cell(tb, 0, 5, "Status", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 5, stTxt, text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 6, "BUY signals", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 6, str.tostring(nBuys) + " on this chart · last " + lastBuy, text_color=C_BUY, text_size=size.small)
