//@version=5
// Stock Blueprint - CHoCH + FVG (discount): the Backtest Lab's rules drawn on the TradingView chart.
// Owner, 11-Nov-2026: "i open trading view chart and i go to that trade date. i check how our backtest enter the trade,
// how our backtest where it is marked Choch, FVG ... it would be helpful if i got pinescript indicator".
// The same rules as the laptop (pcbridge/ScreenerBridge/structure.py, kite_intraday.py, backtest_lab.py):
//  - swing high / low = a candle above / below the N candles on both sides (known - and drawn - N candles later); or (the
//    Lab's "Swings: ZigZag") the highest high since the last swing low, known when price fell x ATR(14) under it (a low
//    mirrored); "A swing must stand out by x ATR" = a candles-each-side swing x ATR above the lowest low around it
//  - CHoCH = the first candle that CLOSES above the last swing high (or the PROTECTED high = the swing high right before the
//    lowest swing low since the last CHoCH) after at least M lower highs AND M lower lows ("Equal highs / lows": a high or
//    low within x ATR of the one before is not lower)
//  - the move = from the CHoCH's final low (the lowest low between that swing high and the CHoCH candle) to the highest high since
//  - BOS = after the CHoCH, the first close above the highest swing high confirmed after it; a close under the final low ends the CHoCH
//  - zones: 3-candle FVG (gap >= 0.70 x the 14-candle average range), Gap-up zones (3 - 5 %, or any size between two big green candles = inside FVG)
//  - BUY = the FIRST time price comes back to a zone that formed after the final low, on the first pullback (no BOS yet),
//    with the zone's middle at least 50 % down the move (the discount); one BUY a candle (the first zone price reaches that passes
//    every rule - also the entry / stop / risk / target rules, like the Lab picks a candle's first row that passes)
// The Backtest Lab page's "Copy TradingView script" button writes the run's rules into the inputs below (owner, 11-Nov-2026:
// "give option to copy the pinescript in this page that works with respect to the current setup").
// Kept in step with tradingview/pine_model.py - tests/tradingview-pine.test.js checks that model against the laptop's Lab runs.
indicator("Stock Blueprint - CHoCH + FVG", shorttitle="SB CHoCH+FVG", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=5000)

// ------------------------------------------------------------------ inputs (= the Backtest Lab's defaults)
G1 = "Market structure (Backtest Lab step 2)"
structOnly = input.bool(true, "Only my setup (the market-structure rules below)", group=G1)
pivN = input.int(5, "A swing: candles each side", minval=2, maxval=20, group=G1)
downN = input.int(3, "Lower highs and lower lows before the CHoCH, at least", minval=1, maxval=8, group=G1)
zoneWhen = input.string("In the CHoCH move or after it", "The zone formed", options=["In the CHoCH move or after it", "Only in the CHoCH move", "Only after the CHoCH candle"], group=G1)
chochAge = input.int(0, "The signal at most N candles after the CHoCH (0 = any)", minval=0, group=G1)
fibLvl = input.float(0.5, "Discount: the zone at least this far down the move (0 = off)", options=[0.0, 0.382, 0.5, 0.618, 0.705, 0.786], group=G1)
discPart = input.string("Middle", "... judged on the zone's", options=["Middle", "Top", "Bottom"], group=G1)
firstPull = input.bool(true, "First pullback only (no BOS yet)", group=G1)
belowChoch = input.bool(false, "Zone top below the CHoCH level (strict)", group=G1)
zonePick = input.string("Trade the 2nd (the 1st only watched)", "Two discount zones in the CHoCH move", options=["Trade the 2nd (the 1st only watched)", "Trade every zone"], group=G1)
touchAgain = input.bool(true, "A zone touched before the CHoCH counts again after it", group=G1)
// how swings and the CHoCH are found (the Lab's More rules > Market structure; owner, 12-Nov-2026)
swMode = input.string("Candles each side", "Swings", options=["Candles each side", "ZigZag (ATR)"], group=G1)
zzAtr = input.float(2.0, "ZigZag: a turn of x ATR(14)", minval=0.5, maxval=10, step=0.5, group=G1)
swAtr = input.float(0.0, "A swing must stand out by x ATR(14) (0 = not checked; candles-each-side swings)", minval=0, maxval=5, step=0.5, group=G1)
chMode = input.string("The last swing high", "The CHoCH closes above", options=["The last swing high", "The protected high"], group=G1)
eqAtr = input.float(0.0, "Equal highs / lows: within x ATR(14) (0 = exact)", minval=0, maxval=2, step=0.05, group=G1)
G2 = "Entry, stop, target (Backtest Lab steps 6 - 7)"
entryMode = input.string("Order at the zone top", "Buy", options=["Order at the zone top", "Touch candle's close"], group=G2)
gapEntry = input.bool(true, "An FVG with a Gap-up zone inside it: buy at the Gap-up zone top (the stop under the FVG)", group=G2)
stopMode = input.string("Under the zone bottom", "Stop loss", options=["Under the zone bottom", "Under the touch candle's low", "Under whichever is lower", "% under the entry", "Under the CHoCH's final low"], group=G2)
stopBuf = input.float(0.5, "Stop: how far below it (%)", minval=0, step=0.1, group=G2)
stopPct = input.float(5.0, "Stop: % under the entry (with that choice)", minval=0.1, step=0.5, group=G2)
stopAtr = input.float(0.0, "Stop: or x ATR(14) under the entry - whichever is lower (0 = off)", minval=0, maxval=10, step=0.5, group=G2)
maxRisk = input.float(15.0, "Skip if the risk is more than % (0 = never)", minval=0, step=1, group=G2)
minPrice = input.float(0.0, "Price at least Rs", minval=0, step=1, group=G2)
targetMode = input.string("R multiple", "Target", options=["R multiple", "The last swing high", "The move high (HH)", "% above the entry"], group=G2)
targetR = input.float(2.0, "Target (R = times the risk)", minval=0.25, step=0.25, group=G2)
targetPct = input.float(20.0, "Target: % above the entry (with that choice)", minval=1, step=5, group=G2)
swingMinR = input.float(1.0, "Swing-high / move-high target: at least this many R above the entry", minval=0, step=0.25, group=G2)
G6 = "Filters (Backtest Lab steps 1 and 4)"
useDates = input.bool(false, "Only signals between these dates", group=G6)
fromDate = input.time(timestamp("01 Jan 2020 00:00 +0530"), "From", group=G6)
toDate = input.time(timestamp("31 Dec 2030 00:00 +0530"), "To", group=G6)
minTurn = input.float(0.0, "Daily turnover at least Rs lakh (20-day average, 0 = off)", minval=0, step=10, group=G6)
emaSup = input.string("Off", "The signal candle took support at", options=["Off", "10 EMA", "21 EMA", "50 EMA", "Any of 10 / 21 / 50"], group=G6)
emaTouch = input.float(1.0, "... its low within % above the EMA", minval=0, step=0.25, group=G6)
ab10 = input.bool(false, "It closed above the 10 EMA", group=G6)
ab21 = input.bool(false, "It closed above the 21 EMA", group=G6)
ab50 = input.bool(false, "It closed above the 50 EMA", group=G6)
emaStack = input.bool(false, "EMAs in order 10 > 21 > 50", group=G6)
G3 = "Zones"
fvgK = input.float(0.70, "FVG: gap at least x the 14-candle average range", minval=0, step=0.05, group=G3)
gapMin = input.float(3.0, "Gap-up zone: gap at least %", minval=0, step=0.5, group=G3)
gapMax = input.float(5.0, "Gap-up zone: gap at most %", minval=0, step=0.5, group=G3)
insideBody = input.float(2.0, "Inside FVG: both green candles' body at least % of the open", minval=0, step=0.5, group=G3)
G4 = "Spring (the pattern's own rule)"
spBody = input.float(0.5, "Red candle: body at least % of its open", minval=0, step=0.1, group=G4)
spUnder = input.float(0.10, "Spring low at least % under the red candle's low", minval=0, step=0.05, group=G4)
spBodyMax = input.float(30.0, "Spring body under % of the red candle's body", minval=1, step=1, group=G4)
spReclaim = input.float(50.0, "Spring high at most % of the red candle's range above its low", minval=1, step=5, group=G4)
sp1315 = input.bool(true, "4H chart: Springs only on the 13:15 candle", group=G4)
G5 = "Show"
showSwings = input.bool(true, "Swing highs / lows", group=G5)
showZones = input.bool(true, "Zones of the CHoCH move (while price has not come back)", group=G5)
showAll = input.bool(false, "Every FVG / Gap-up zone", group=G5)
showSpring = input.bool(true, "Spring candles (S)", group=G5)
showTable = input.bool(true, "Summary table (the current CHoCH)", group=G5)
markOn = input.bool(false, "Mark a trade date", group=G5)
markDate = input.time(timestamp("01 Jan 2026 00:00 +0530"), "Trade date (from the Backtest Lab)", group=G5)

C_CHOCH = #b388ff
C_FIB = #ffd166
C_BUY = #00c853
C_STOP = #ff5252
C_TGT = #448aff
C_FVG = #26a69a
C_GAP = #ab47bc
C_SW = #ffb74d
TZ = "Asia/Kolkata"

// ------------------------------------------------------------------ helpers
pivotHigh(int n) =>
    bool ok = bar_index >= 2 * n
    if ok
        float x = high[n]
        for k = 1 to n
            if not (x > high[n + k] and x >= high[n - k])
                ok := false
                break
    ok

pivotLow(int n) =>
    bool ok = bar_index >= 2 * n
    if ok
        float y = low[n]
        for k = 1 to n
            if not (y < low[n + k] and y <= low[n - k])
                ok := false
                break
    ok

isLocked(float h, float l) =>
    l > 0 and (h - l) / l * 100 <= 0.05

bigGreen(float o, float c) =>
    o > 0 and c > o and (c - o) / o * 100 >= insideBody

two(int v) =>
    (v < 10 ? "0" : "") + str.tostring(v)

fmtT(int t) =>
    string s = str.tostring(year(t, TZ)) + "-" + two(month(t, TZ)) + "-" + two(dayofmonth(t, TZ))
    timeframe.isintraday ? s + " " + two(hour(t, TZ)) + ":" + two(minute(t, TZ)) : s

fmtP(float v) =>
    str.tostring(v, format.mintick)

// a new zone (f, Gap-up or FVG, bottom, top) linked with the zones of the last 3 candles (= kite_intraday.link_zones, 12-Nov-2026):
// a Gap-up zone wholly inside an FVG zone - the FVG "has one inside" (its touch waits for the Gap-up zone), the Gap-up zone keeps
// the widest FVG's bottom (its stop)
linkZone(int f, bool g, float b, float t, array<int> zF_, array<bool> zGap_, array<bool> zInner_, array<float> zOutB_, array<int> zOutF_, array<int> rF_, array<bool> rGap_, array<float> rBot_, array<float> rTop_) =>
    int me = array.size(zF_) - 1
    int nr = array.size(rF_)
    if nr > 0
        for j = 0 to nr - 1
            int rf = array.get(rF_, j)
            bool rg = array.get(rGap_, j)
            if rg != g and math.abs(rf - f) <= 3
                float rb = array.get(rBot_, j)
                float rt = array.get(rTop_, j)
                float ib = g ? b : rb
                float it = g ? t : rt
                float ob = g ? rb : b
                float ot = g ? rt : t
                if ib >= ob - 0.000000001 and it <= ot + 0.000000001
                    int target = g ? me : -1
                    float nb = g ? rb : b
                    int nf = g ? rf : f
                    if not g
                        array.set(zInner_, me, true)
                    int nz = array.size(zF_)
                    if nz > 0
                        for k = 0 to nz - 1
                            if array.get(zF_, k) == rf and array.get(zGap_, k) == rg
                                if g
                                    array.set(zInner_, k, true)
                                else
                                    target := k
                    if target >= 0
                        float cb = array.get(zOutB_, target)
                        int cf = array.get(zOutF_, target)
                        if na(cb) or nb < cb or (nb == cb and nf < cf)
                            array.set(zOutB_, target, nb)
                            array.set(zOutF_, target, nf)
    array.push(rF_, f)
    array.push(rGap_, g)
    array.push(rBot_, b)
    array.push(rTop_, t)
    true

// the market-structure rules of a zone (candle f, bottom, top) under the current CHoCH - the BUY's own test (the 2nd-zone rule)
zPass(int f, float zb, float zt, int li, int cb, int bos, float lvl, float hh, float lf, int mhb) =>
    bool ok = f >= li
    // the owner's rules of 13-Nov-2026: no zone wholly above the CHoCH level; the zone formed in the swing final low -> move high
    if zb >= lvl - 0.000000001
        ok := false
    if f > mhb
        ok := false
    if zoneWhen == "Only in the CHoCH move" and f > cb + 1
        ok := false
    if zoneWhen == "Only after the CHoCH candle" and f <= cb
        ok := false
    if firstPull and bos >= 0
        ok := false
    if belowChoch and not (zt < lvl)
        ok := false
    if fibLvl > 0
        float part = discPart == "Top" ? zt : discPart == "Bottom" ? zb : (zb + zt) / 2
        float dep = hh > lf ? (hh - part) / (hh - lf) : na
        if na(dep) or dep < fibLvl - 0.000000001
            ok := false
    ok

// ------------------------------------------------------------------ every bar
bool isZz = swMode == "ZigZag (ATR)"
bool isProt = chMode == "The protected high"
string swTxt = (isZz ? "ZigZag " + str.tostring(zzAtr) + " x ATR" : str.tostring(pivN) + " candles each side" + (swAtr > 0 ? ", standing out " + str.tostring(swAtr) + " x ATR" : "")) + (isProt ? " · protected high" : "") + (eqAtr > 0 ? " · equal within " + str.tostring(eqAtr) + " x ATR" : "")
// ATR(14) like the laptop: the mean true range of the last 14 candles (of the ones there are at the start)
float trNow = bar_index == 0 ? high - low : math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
float trCum = ta.cum(trNow)
float atrS = (trCum - (bar_index >= 14 ? trCum[14] : 0.0)) / math.min(bar_index + 1, 14)
float loWin = ta.lowest(low, 2 * pivN + 1)
float hiWin = ta.highest(high, 2 * pivN + 1)
bool phRaw = pivotHigh(pivN)
bool plRaw = pivotLow(pivN)
// candles-each-side swings (not with ZigZag); "stand out by x ATR": above the lowest low / under the highest high around it
bool ph = not isZz and phRaw and (swAtr <= 0 or high[pivN] - loWin >= swAtr * atrS[pivN])
bool pl = not isZz and plRaw and (swAtr <= 0 or hiWin - low[pivN] >= swAtr * atrS[pivN])

// the ATR ZigZag: a swing high = the highest high since the last swing low, known on the first candle whose low is zzAtr x
// ATR under it (a swing low mirrored); then the other side starts from the lowest low / highest high after it (the latest of equals)
var int zzD = 0
var int zzHi = 0
var float zzHiV = na
var int zzLo = 0
var float zzLoV = na
bool zzNewHi = false
bool zzNewLo = false
int zzP = -1
float zzV = na
if isZz
    if bar_index == 0
        zzHiV := high
        zzLoV := low
    else
        float zA = zzAtr * atrS
        if zzD >= 0 and high > zzHiV
            zzHi := bar_index
            zzHiV := high
        if zzD <= 0 and low < zzLoV
            zzLo := bar_index
            zzLoV := low
        if zzD >= 0 and zzHi < bar_index and zzHiV - low >= zA and (zzD == 1 or zzHi >= zzLo)
            zzNewHi := true
            zzP := zzHi
            zzV := zzHiV
            zzD := -1
            zzLo := bar_index
            zzLoV := low
            int m1 = bar_index - zzP - 1
            if m1 > 0
                for off = 1 to m1
                    if low[off] < zzLoV
                        zzLo := bar_index - off
                        zzLoV := low[off]
        else if zzD <= 0 and zzLo < bar_index and high - zzLoV >= zA and (zzD == -1 or zzLo > zzHi)
            zzNewLo := true
            zzP := zzLo
            zzV := zzLoV
            zzD := 1
            zzHi := bar_index
            zzHiV := high
            int m2 = bar_index - zzP - 1
            if m2 > 0
                for off = 1 to m2
                    if high[off] > zzHiV
                        zzHi := bar_index - off
                        zzHiV := high[off]

// the swing confirmed on this candle (for the structure) and the swing high known now (the swing-high target and the BOS)
bool swNew = isZz ? (zzNewHi or zzNewLo) : ph != pl
bool swNewH = isZz ? zzNewHi : ph
int swNewP = isZz ? zzP : bar_index - pivN
float swNewV = isZz ? zzV : ph ? high[pivN] : low[pivN]
bool hiNew = isZz ? zzNewHi : ph
int hiNewP = isZz ? zzP : bar_index - pivN
float hiNewV = isZz ? zzV : high[pivN]
bool lockNow = isLocked(high, low)
bool lockPrev = bar_index >= 1 and isLocked(high[1], low[1])
bool gapAny = bar_index >= 1 and not lockNow and not lockPrev and high[1] > 0 and low > high[1]
float gapPct = gapAny ? (low - high[1]) / high[1] * 100 : na
float avgRange = ta.sma(high - low, 14)

// the swing highs known so far (for the swing-high target): pushed when confirmed
var phV = array.new_float()
if hiNew
    array.push(phV, hiNewV)

// EMAs like the Lab (seeded with the first close) and its confluence rules on the signal candle
var float e10 = na
var float e21 = na
var float e50 = na
e10 := na(e10) ? close : e10 + 2.0 / 11.0 * (close - e10)
e21 := na(e21) ? close : e21 + 2.0 / 22.0 * (close - e21)
e50 := na(e50) ? close : e50 + 2.0 / 51.0 * (close - e50)
bool emaAny = emaSup != "Off" or ab10 or ab21 or ab50 or emaStack
bool need50 = emaSup == "50 EMA" or emaSup == "Any of 10 / 21 / 50" or ab50 or emaStack
bool need21 = emaSup == "21 EMA" or emaSup == "Any of 10 / 21 / 50" or ab21 or emaStack
int emaLen = need50 ? 50 : need21 ? 21 : 10
float tch = 1 + emaTouch / 100
bool s10 = low <= e10 * tch and close >= e10
bool s21 = low <= e21 * tch and close >= e21
bool s50 = low <= e50 * tch and close >= e50
bool supOk = emaSup == "Off" ? true : emaSup == "10 EMA" ? s10 : emaSup == "21 EMA" ? s21 : emaSup == "50 EMA" ? s50 : (s10 or s21 or s50)
bool emaOk = not emaAny or (bar_index >= emaLen and supOk and (not ab10 or close > e10) and (not ab21 or close > e21) and (not ab50 or close > e50) and (not emaStack or (e10 > e21 and e21 > e50)))

// the 20-day average daily turnover (close x volume) in Rs lakh, like the Lab (daily candles on any chart)
float cvCum = ta.cum(close * volume)
float turnHere = (cvCum - (bar_index >= 20 ? cvCum[20] : 0.0)) / math.min(bar_index + 1, 20) / 100000
float turnDaily = request.security(syminfo.tickerid, "D", turnHere)
float turnLakh = timeframe.isdaily ? turnHere : turnDaily
bool turnOk = minTurn <= 0 or math.round(turnLakh * 10) / 10.0 >= minTurn
bool dateOk = not useDates or (time >= fromDate and time < toDate + 86400000)

// swings (alternating: a second high before a low keeps the higher one) and the CHoCH state
var swP = array.new_int()
var swV = array.new_float()
var swH = array.new_bool()
var swA = array.new_float()
var int swBase = 0
var int lastUsedHi = -1
var int segHi = -1
var float segMin = na
var int segMinBar = -1
var int chB = -1
var int chHi = -1
var float chLvl = na
var int chLi = -1
var float chLf = na
var int chD = 0
var bool chDead = true
var int chBos = -1
var float chPeak = na
var int chPeakBar = -1
var float chH = na
var int chHBar = -1
var int chTime = 0
var int chLiTime = 0
var line fibLn = na
var label fibLb = na
var int nBuys = 0
var string lastBuy = "-"
// zones not touched yet
var zF = array.new_int()
var zBot = array.new_float()
var zTop = array.new_float()
var zGap = array.new_bool()
var zIn = array.new_bool()
var zInner = array.new_bool()
var zOutB = array.new_float()
var zOutF = array.new_int()
var rF = array.new_int()
var rGap = array.new_bool()
var rBot = array.new_float()
var rTop = array.new_float()
var zBox = array.new_box()
var hitList = array.new_int()
// the zones price has touched (the 2nd-zone rule: "1st FVG can be watched but not to be traded" - owner, 12-Nov-2026)
var tzF = array.new_int()
var tzB = array.new_float()
var tzT = array.new_float()
var tzG = array.new_bool()
var tzIn = array.new_bool()
var tzInner = array.new_bool()
var tzOutB = array.new_float()
var tzOutF = array.new_int()
var rmList = array.new_int()
var abB = array.new_float()
var abT = array.new_float()
var abF = array.new_int()

// 1. a close under the final low ends the CHoCH (this candle too)
bool alive = chB >= 0 and not chDead and chB < bar_index
if alive and close < chLf
    chDead := true
    alive := false
    label.new(bar_index, low, "CHoCH ended", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.gray, 30), textcolor=color.white, size=size.tiny, tooltip="A close under the CHoCH's final low " + fmtP(chLf) + " - no more setups from this CHoCH")

// 1b. the candle before's gap between two big green candles (inside FVG - judged now that this candle closed); added before
//     the touches so the FVG around it knows it (this candle cannot touch it: its low is over the gap's top). The zones of the
//     last few candles are kept for the links.
bool prune = true
while prune
    if array.size(rF) > 0
        if array.get(rF, 0) < bar_index - 5
            array.shift(rF)
            array.shift(rGap)
            array.shift(rBot)
            array.shift(rTop)
        else
            prune := false
    else
        prune := false
bool zoneBoxOn = showAll or (showZones and chB >= 0 and not chDead)
if bar_index >= 3 and gapAny[1] and gapPct[1] <= gapMax
    if bigGreen(open[2], close[2]) and bigGreen(open[1], close[1]) and low[1] > high[2] and high[3] < high[2] and low > low[1]
        if gapPct[1] >= gapMin
            int nz5 = array.size(zF)
            if nz5 > 0
                for k = 0 to nz5 - 1
                    if array.get(zF, k) == bar_index - 1 and array.get(zGap, k)
                        array.set(zIn, k, true)
        else
            array.push(zF, bar_index - 1)
            array.push(zBot, high[2])
            array.push(zTop, low[1])
            array.push(zGap, true)
            array.push(zIn, true)
            array.push(zInner, false)
            array.push(zOutB, na)
            array.push(zOutF, -1)
            box nb3 = na
            if zoneBoxOn and (showAll or bar_index - 1 >= chLi)
                nb3 := box.new(bar_index - 2, low[1], bar_index, high[2], border_color=color.new(C_GAP, 40), bgcolor=color.new(C_GAP, 88), extend=extend.right)
            array.push(zBox, nb3)
            linkZone(bar_index - 1, true, high[2], low[1], zF, zGap, zInner, zOutB, zOutF, rF, rGap, rBot, rTop)

// 2. the zones this candle touches for the first time (low <= zone top; a Gap-up zone never on a circuit-locked candle) -
//    the first one (highest top, FVG before Gap-up, older first) that passes every rule = the BUY
array.clear(hitList)
int best = -1
float bEntry = na
float bStop = na
float bTgt = na
float bDep = na
string skipWhy = ""
bool aliveOk = alive and (chochAge == 0 or bar_index - chB <= chochAge)
bool pick2nd = structOnly and zonePick == "Trade the 2nd (the 1st only watched)"
int nz = array.size(zF)
if nz > 0
    for k = 0 to nz - 1
        if low <= array.get(zTop, k) and (not array.get(zGap, k) or not lockNow)
            array.push(hitList, k)
int nh0 = array.size(hitList)
if nh0 > 0
    for q = 0 to nh0 - 1
        int k = array.get(hitList, q)
        float zt = array.get(zTop, k)
        bool zg = array.get(zGap, k)
        int f = array.get(zF, k)
        float zb = array.get(zBot, k)
        float part = discPart == "Top" ? zt : discPart == "Bottom" ? zb : (zb + zt) / 2
        float dep = aliveOk and chH > chLf ? (chH - part) / (chH - chLf) : na
        bool ok = true
        // an FVG with a Gap-up zone inside it: the order waits at the Gap-up zone top (its own touch); a Gap-up zone inside an
        // FVG: the stop under the FVG's bottom
        bool waitsInside = gapEntry and not zg and array.get(zInner, k)
        float zbStop = gapEntry and zg and not na(array.get(zOutB, k)) ? array.get(zOutB, k) : zb
        if waitsInside
            ok := false
        if structOnly and ok
            ok := aliveOk and f >= chLi
            if zb >= chLvl - 0.000000001
                ok := false
            if f > chHBar
                ok := false
            if zoneWhen == "Only in the CHoCH move" and f > chB + 1
                ok := false
            if zoneWhen == "Only after the CHoCH candle" and f <= chB
                ok := false
            if firstPull and chBos >= 0
                ok := false
            if belowChoch and not (zt < chLvl)
                ok := false
            if fibLvl > 0 and (na(dep) or dep < fibLvl - 0.000000001)
                ok := false
        if structOnly and ok and pick2nd
            // the 2nd-zone rule: the discount zones above this one (touched before or now; overlapping ones = one area) and an
            // untouched one under it - of two the 1st is only watched, a 3rd is not traded
            array.clear(abB)
            array.clear(abT)
            array.clear(abF)
            int ntz = array.size(tzF)
            if ntz > 0
                for j = 0 to ntz - 1
                    int fj = array.get(tzF, j)
                    float bj = array.get(tzB, j)
                    float tj = array.get(tzT, j)
                    if fj >= chLi and fj < bar_index and bj >= zt - 0.000000001 and zPass(fj, bj, tj, chLi, chB, chBos, chLvl, chH, chLf, chHBar)
                        array.push(abB, bj)
                        array.push(abT, tj)
                        array.push(abF, fj)
            if nh0 > 0
                for j = 0 to nh0 - 1
                    int kj = array.get(hitList, j)
                    if kj != k
                        int fj = array.get(zF, kj)
                        float bj = array.get(zBot, kj)
                        float tj = array.get(zTop, kj)
                        if fj >= chLi and fj < bar_index and bj >= zt - 0.000000001 and zPass(fj, bj, tj, chLi, chB, chBos, chLvl, chH, chLf, chHBar)
                            array.push(abB, bj)
                            array.push(abT, tj)
                            array.push(abF, fj)
            bool lowerZ = false
            if nz > 0
                for j = 0 to nz - 1
                    if j != k and not lowerZ
                        int fj = array.get(zF, j)
                        float tj = array.get(zTop, j)
                        if fj >= chLi and fj < bar_index and tj <= zb + 0.000000001 and zPass(fj, array.get(zBot, j), tj, chLi, chB, chBos, chLvl, chH, chLf, chHBar)
                            lowerZ := true
            int areas = 0
            int nab = array.size(abB)
            int[] ordA = array.sort_indices(abB, order.ascending)
            float curT = na
            float a1T = na
            int a1F = 0
            if nab > 0
                for j = 0 to nab - 1
                    int x = array.get(ordA, j)
                    if na(curT) or array.get(abB, x) > curT + 0.000000001
                        areas += 1
                        curT := array.get(abT, x)
                        if areas == 1
                            a1T := curT
                            a1F := array.get(abF, x)
                    else
                        curT := math.max(curT, array.get(abT, x))
                        if areas == 1
                            a1T := curT
                            a1F := math.min(a1F, array.get(abF, x))
            // the 1st (watched) zone must not be touched before the move high (owner, 13-Nov-2026, APTUS)
            int a1n = 0
            if areas == 1
                int oA1 = bar_index - chHBar
                int oB1 = bar_index - a1F - 1
                if oB1 >= oA1
                    for o8 = oA1 to oB1
                        if low[o8] <= a1T + 0.000000001
                            a1n += 1
            if areas >= 2
                skipWhy := "a 3rd discount zone of the CHoCH move - only the 2nd is traded"
                ok := false
            else if a1n > 0
                skipWhy := "the 1st (watched) zone was touched before the move high"
                ok := false
            else if areas == 0 and lowerZ
                skipWhy := "the 1st of two discount zones of the CHoCH move - only watched (your rule: the trade is on the 2nd, under it)"
                ok := false
        if structOnly and ok
            // the owner's rules of 13-Nov-2026: at most 2 candles in the zone and no close under its middle before the move high
            int oA = bar_index - chHBar
            int oB = bar_index - f - 1
            int nT = 0
            bool deepC = false
            if oB >= oA
                for o9 = oA to oB
                    if low[o9] <= zt + 0.000000001
                        nT += 1
                        if close[o9] < (zb + zt) / 2 - 0.000000001
                            deepC := true
            if deepC
                skipWhy := "a candle closed under the zone's middle before the move high"
                ok := false
            else if nT > 2
                skipWhy := "more than 2 candles touched the zone before the move high"
                ok := false
        if ok and not dateOk
            ok := false
        if ok and not turnOk
            skipWhy := "the daily turnover was under Rs " + str.tostring(minTurn) + " lakh"
            ok := false
        if ok and not emaOk
            skipWhy := "the EMA rules did not agree"
            ok := false
        if ok
            bool atTop = entryMode == "Order at the zone top"
            float entry = atTop ? math.min(open, zt) : close
            string sm = atTop and (stopMode == "Under the touch candle's low" or stopMode == "Under whichever is lower") ? "Under the zone bottom" : stopMode
            float base = sm == "Under the touch candle's low" ? low : sm == "Under whichever is lower" ? math.min(low, zbStop) : zbStop
            float stop = sm == "% under the entry" ? entry * (1 - stopPct / 100) : sm == "Under the CHoCH's final low" ? chLf * (1 - stopBuf / 100) : base * (1 - stopBuf / 100)
            // the ATR stop (owner, 13-Nov-2026): the lower of the two; the order at the zone top uses the ATR of the bar before
            if stopAtr > 0
                stop := math.min(stop, entry - stopAtr * (atTop ? atrS[1] : atrS))
            float risk = entry - stop
            float tgt = targetMode == "% above the entry" ? entry * (1 + targetPct / 100) : entry + targetR * risk
            if sm == "Under the CHoCH's final low" and not aliveOk
                skipWhy := "no live CHoCH (the stop goes under its final low)"
                ok := false
            else if not (entry > 0 and risk > 0)
                skipWhy := "it opened under the stop (a gap)"
                ok := false
            else if maxRisk > 0 and risk / entry * 100 > maxRisk
                skipWhy := "the risk was " + str.tostring(math.round(risk / entry * 1000) / 10.0) + "% (more than " + str.tostring(maxRisk) + "%)"
                ok := false
            else if entry < minPrice
                skipWhy := "the price was under Rs " + str.tostring(minPrice)
                ok := false
            else if targetMode == "The last swing high"
                float above = entry + swingMinR * risk
                float sw = na
                int np = array.size(phV)
                if np > 0
                    for j = np - 1 to 0
                        if array.get(phV, j) >= above
                            sw := array.get(phV, j)
                            break
                if na(sw)
                    skipWhy := "no swing high at least " + str.tostring(swingMinR) + "R above the entry"
                    ok := false
                else
                    tgt := sw
            else if targetMode == "The move high (HH)"
                if not aliveOk or na(chH) or chH <= entry or chH < entry + swingMinR * risk - 0.000000001
                    skipWhy := "no CHoCH move high at least " + str.tostring(swingMinR) + "R above the entry"
                    ok := false
                else
                    tgt := chH
            if ok
                bool before = best < 0
                if not before
                    float bt = array.get(zTop, best)
                    bool bg = array.get(zGap, best)
                    before := zt > bt or (zt == bt and not zg and bg) or (zt == bt and zg == bg and f < array.get(zF, best))
                if before
                    best := k
                    bEntry := entry
                    bStop := stop
                    bTgt := tgt
                    bDep := dep

string chTxt = structOnly and aliveOk ? "CHoCH " + fmtP(chLvl) + " on " + fmtT(chTime) + " (" + str.tostring(chD) + " lower highs / lows, final low " + fmtP(chLf) + " on " + fmtT(chLiTime) + ")\nmove high " + fmtP(chH) : "no market-structure rule"
if best >= 0
    float zb = array.get(zBot, best)
    float zt = array.get(zTop, best)
    int f = array.get(zF, best)
    bool isGap = array.get(zGap, best)
    string kind = isGap ? (array.get(zIn, best) ? "Gap-up zone (inside FVG)" : "Gap-up zone") : "FVG"
    string tip = chTxt + "\n" + kind + " " + fmtP(zb) + " - " + fmtP(zt) + (na(bDep) ? "" : ", its " + str.lower(discPart) + " " + str.tostring(math.round(bDep * 100)) + "% down the move") + (structOnly and fibLvl > 0 and aliveOk ? " (" + str.tostring(fibLvl * 100) + "% line " + fmtP(chH - fibLvl * (chH - chLf)) + ")" : "")
    nBuys += 1
    lastBuy := fmtT(time) + " at " + fmtP(bEntry)
    tip := tip + "\nentry " + fmtP(bEntry) + " · stop " + fmtP(bStop) + " · target " + fmtP(bTgt) + (targetMode == "R multiple" ? " (" + str.tostring(targetR) + "R)" : targetMode == "% above the entry" ? " (" + str.tostring(targetPct) + "% above)" : targetMode == "The move high (HH)" ? " (the move high)" : " (the last swing high)") + (stopAtr > 0 ? " · stop: the lower of the rule's and " + str.tostring(stopAtr) + " x ATR" : "") + " · risk " + str.tostring(math.round((bEntry - bStop) / bEntry * 1000) / 10.0) + "%"
    label.new(bar_index, low, "BUY " + fmtP(bEntry), yloc=yloc.belowbar, style=label.style_label_up, color=C_BUY, textcolor=color.white, size=size.small, tooltip=tip)
    line.new(bar_index, bEntry, bar_index + 8, bEntry, color=C_BUY, width=2)
    line.new(bar_index, bStop, bar_index + 8, bStop, color=C_STOP, width=2)
    line.new(bar_index, bTgt, bar_index + 8, bTgt, color=C_TGT, width=2, style=line.style_dashed)
    box bxb = array.get(zBox, best)
    if na(bxb)
        box.new(isGap ? f - 1 : f - 2, zt, bar_index, zb, border_color=C_BUY, bgcolor=color.new(C_BUY, 80), text=(structOnly and fibLvl > 0 ? "discount " : "") + kind, text_size=size.tiny, text_color=C_BUY, text_halign=text.align_left, text_valign=text.align_top)
    else
        box.set_bgcolor(bxb, color.new(C_BUY, 80))
        box.set_border_color(bxb, C_BUY)
        box.set_text(bxb, (structOnly and fibLvl > 0 ? "discount " : "") + kind)
        box.set_text_color(bxb, C_BUY)
        box.set_text_size(bxb, size.tiny)
else if skipWhy != ""
    label.new(bar_index, low, "skip", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.gray, 20), textcolor=color.white, size=size.tiny, tooltip="A zone's first touch passed the market-structure rules, but the Lab would skip it: " + skipWhy + "\n" + chTxt)

// touched zones leave the list (their box stops at this candle; grey = touched, not a setup)
int nh = array.size(hitList)
if nh > 0
    for j = nh - 1 to 0
        int k = array.get(hitList, j)
        array.push(tzF, array.get(zF, k))
        array.push(tzB, array.get(zBot, k))
        array.push(tzT, array.get(zTop, k))
        array.push(tzG, array.get(zGap, k))
        array.push(tzIn, array.get(zIn, k))
        array.push(tzInner, array.get(zInner, k))
        array.push(tzOutB, array.get(zOutB, k))
        array.push(tzOutF, array.get(zOutF, k))
        box bx = array.get(zBox, k)
        if not na(bx)
            box.set_right(bx, bar_index)
            box.set_extend(bx, extend.none)
            if k != best
                box.set_bgcolor(bx, color.new(color.gray, 88))
                box.set_border_color(bx, color.new(color.gray, 55))
        array.remove(zF, k)
        array.remove(zBot, k)
        array.remove(zTop, k)
        array.remove(zGap, k)
        array.remove(zIn, k)
        array.remove(zInner, k)
        array.remove(zOutB, k)
        array.remove(zOutF, k)
        array.remove(zBox, k)
// the touched zones kept for the 2nd-zone rule / touchAgain: the newest 300 (= pine_model ZONES_KEPT)
while array.size(tzF) > 300
    array.shift(tzF)
    array.shift(tzB)
    array.shift(tzT)
    array.shift(tzG)
    array.shift(tzIn)
    array.shift(tzInner)
    array.shift(tzOutB)
    array.shift(tzOutF)

// 3. BOS: a swing high confirmed now (after the CHoCH candle) raises the peak; a close above the peak = BOS
if chB >= 0 and not chDead and chBos < 0 and bar_index > chB
    if hiNew and hiNewP > chB and (na(chPeak) or hiNewV > chPeak)
        chPeak := hiNewV
        chPeakBar := hiNewP
    if not na(chPeak) and close > chPeak
        chBos := bar_index
        line.new(chPeakBar, chPeak, bar_index, chPeak, color=C_STOP, width=1)
        label.new(bar_index, chPeak, "BOS", style=label.style_label_down, color=color.new(C_STOP, 10), textcolor=color.white, size=size.tiny, tooltip="Break of structure: a close above the highest swing high " + fmtP(chPeak) + " since the CHoCH - price already moved; later touches are not the first pullback")

// 4. the move's high (the next candles' discount line)
if chB >= 0 and not chDead and bar_index > chB
    if high > chH
        chH := high
        chHBar := bar_index
if chB >= 0 and not chDead and fibLvl > 0 and not na(fibLn)
    float fpx = chH - fibLvl * (chH - chLf)
    line.set_y1(fibLn, fpx)
    line.set_xy2(fibLn, bar_index, fpx)
    label.set_xy(fibLb, bar_index, fpx)
    label.set_text(fibLb, str.tostring(fibLvl * 100) + "% " + fmtP(fpx))

// 5. new zones: a 3-candle FVG on this candle, a Gap-up zone 3 - 5 % on this candle (the inside-FVG gap: 1b)
if bar_index >= 13 and low > high[2] and (low - high[2]) >= fvgK * avgRange
    array.push(zF, bar_index)
    array.push(zBot, high[2])
    array.push(zTop, low)
    array.push(zGap, false)
    array.push(zIn, false)
    array.push(zInner, false)
    array.push(zOutB, na)
    array.push(zOutF, -1)
    box nb1 = na
    if zoneBoxOn and (showAll or bar_index >= chLi)
        nb1 := box.new(bar_index - 2, low, bar_index, high[2], border_color=color.new(C_FVG, 40), bgcolor=color.new(C_FVG, 88), extend=extend.right)
    array.push(zBox, nb1)
    linkZone(bar_index, false, high[2], low, zF, zGap, zInner, zOutB, zOutF, rF, rGap, rBot, rTop)
if gapAny and gapPct >= gapMin and gapPct <= gapMax
    array.push(zF, bar_index)
    array.push(zBot, high[1])
    array.push(zTop, low)
    array.push(zGap, true)
    array.push(zIn, false)
    array.push(zInner, false)
    array.push(zOutB, na)
    array.push(zOutF, -1)
    box nb2 = na
    if zoneBoxOn and (showAll or bar_index >= chLi)
        nb2 := box.new(bar_index - 1, low, bar_index, high[1], border_color=color.new(C_GAP, 40), bgcolor=color.new(C_GAP, 88), extend=extend.right)
    array.push(zBox, nb2)
    linkZone(bar_index, true, high[1], low, zF, zGap, zInner, zOutB, zOutF, rF, rGap, rBot, rTop)
// the oldest untouched zones go (they formed long before any CHoCH that could use them)
if array.size(zF) > 300
    box old = array.shift(zBox)
    if not na(old)
        box.delete(old)
    array.shift(zF)
    array.shift(zBot)
    array.shift(zTop)
    array.shift(zGap)
    array.shift(zIn)
    array.shift(zInner)
    array.shift(zOutB)
    array.shift(zOutF)

// 6. swings (confirmed later, alternating: a second high before a low keeps the higher one) and the CHoCH (a close above the
//    last swing high - or the protected high)
if swNew
    float swAt = atrS[bar_index - swNewP]
    int sz = array.size(swP)
    bool same = false
    if sz > 0
        same := array.get(swH, sz - 1) == swNewH
    if same
        float lastV = array.get(swV, sz - 1)
        if (swNewH and swNewV > lastV) or (not swNewH and swNewV < lastV)
            array.set(swP, sz - 1, swNewP)
            array.set(swV, sz - 1, swNewV)
            array.set(swA, sz - 1, swAt)
    else
        array.push(swP, swNewP)
        array.push(swV, swNewV)
        array.push(swH, swNewH)
        array.push(swA, swAt)
int sz6 = array.size(swP)
if sz6 > 0
    int q = -1
    if isProt
        // the protected high: the swing high right before the lowest swing low since the last CHoCH (the latest of equal lows)
        int kMin = -1
        float vMin = na
        if sz6 > swBase
            for k = swBase to sz6 - 1
                if not array.get(swH, k)
                    float vk = array.get(swV, k)
                    if kMin < 0 or vk <= vMin
                        kMin := k
                        vMin := vk
        q := kMin >= 0 ? kMin - 1 : -1
    else
        q := array.get(swH, sz6 - 1) ? sz6 - 1 : sz6 - 2
    if q >= 0
        int hiBar = array.get(swP, q)
        float lvl = array.get(swV, q)
        if hiBar != segHi
            segHi := hiBar
            segMin := na
            segMinBar := -1
            int span = bar_index - hiBar
            if span > 0
                for k = 1 to span
                    int off = span - k
                    if na(segMin) or low[off] < segMin
                        segMin := low[off]
                        segMinBar := bar_index - off
        else if low < segMin
            segMin := low
            segMinBar := bar_index
        if close > lvl and hiBar > lastUsedHi
            lastUsedHi := hiBar
            int dh = 0
            int kk = q
            bool more = true
            while more
                if kk - 2 >= 0
                    if array.get(swV, kk) < array.get(swV, kk - 2) - eqAtr * array.get(swA, kk)
                        dh += 1
                        kk -= 2
                    else
                        more := false
                else
                    more := false
            int dl = 0
            float prevLow = segMin
            kk := q - 1
            more := true
            while more
                if kk >= 0
                    if prevLow < array.get(swV, kk) - eqAtr * array.get(swA, kk)
                        dl += 1
                        prevLow := array.get(swV, kk)
                        kk -= 2
                    else
                        more := false
                else
                    more := false
            int d = math.min(dh, dl)
            if d >= 1 and isProt
                swBase := sz6
            if d >= downN
                chB := bar_index
                chHi := hiBar
                chLvl := lvl
                chLi := segMinBar
                chLf := segMin
                chD := d
                chDead := false
                chBos := -1
                chPeak := na
                chPeakBar := -1
                chTime := time
                chLiTime := time[bar_index - segMinBar]
                float mh = na
                int mhb = bar_index
                int span2 = bar_index - chLi
                for k = 0 to span2
                    if na(mh) or high[k] >= mh
                        mh := high[k]
                        mhb := bar_index - k
                chH := mh
                chHBar := mhb
                line.new(chHi, chLvl, bar_index, chLvl, color=C_CHOCH, width=2, style=line.style_dashed)
                label.new(bar_index, chLvl, "CHoCH (" + str.tostring(d) + ")", style=label.style_label_down, color=color.new(C_CHOCH, 10), textcolor=color.white, size=size.small, tooltip="CHoCH " + fmtP(chLvl) + " on " + fmtT(time) + ": a close above " + (isProt ? "the protected high (the swing high before the lowest low)" : "the last swing high") + " after " + str.tostring(d) + " lower highs and lower lows" + (eqAtr > 0 ? " (within " + str.tostring(eqAtr) + " x ATR = equal, not lower)" : "") + ". Final low " + fmtP(chLf) + " on " + fmtT(chLiTime) + ". Swings: " + swTxt)
                label.new(chLi, chLf, "final low", yloc=yloc.price, style=label.style_label_up, color=color.new(C_CHOCH, 40), textcolor=color.white, size=size.tiny)
                if fibLvl > 0
                    float fp0 = chH - fibLvl * (chH - chLf)
                    fibLn := line.new(chLi, fp0, bar_index, fp0, color=C_FIB, width=1, style=line.style_dotted)
                    fibLb := label.new(bar_index, fp0, str.tostring(fibLvl * 100) + "% " + fmtP(fp0), style=label.style_label_left, color=color.new(C_FIB, 100), textcolor=C_FIB, size=size.tiny)
                // a zone of this move price touched before now that held (no close under its bottom) waits again - its first
                // touch after the CHoCH counts (owner, 13-Nov-2026, SWIGGY)
                if structOnly and touchAgain
                    array.clear(rmList)
                    int ntz6 = array.size(tzF)
                    if ntz6 > 0
                        for q6 = 0 to ntz6 - 1
                            int f6 = array.get(tzF, q6)
                            float b6 = array.get(tzB, q6)
                            if f6 >= chLi
                                bool held6 = true
                                int back6 = bar_index - f6 - 1
                                if back6 >= 0
                                    for j6 = 0 to back6
                                        if close[j6] < b6
                                            held6 := false
                                            break
                                if held6
                                    array.push(zF, f6)
                                    array.push(zBot, b6)
                                    array.push(zTop, array.get(tzT, q6))
                                    array.push(zGap, array.get(tzG, q6))
                                    array.push(zIn, array.get(tzIn, q6))
                                    array.push(zInner, array.get(tzInner, q6))
                                    array.push(zOutB, array.get(tzOutB, q6))
                                    array.push(zOutF, array.get(tzOutF, q6))
                                    array.push(zBox, na)
                                    array.push(rmList, q6)
                    int nrm6 = array.size(rmList)
                    if nrm6 > 0
                        for q7 = nrm6 - 1 to 0
                            int x7 = array.get(rmList, q7)
                            array.remove(tzF, x7)
                            array.remove(tzB, x7)
                            array.remove(tzT, x7)
                            array.remove(tzG, x7)
                            array.remove(tzIn, x7)
                            array.remove(tzInner, x7)
                            array.remove(tzOutB, x7)
                            array.remove(tzOutF, x7)
                // the zones of this move that wait for price (formed after the final low, not touched yet)
                if showZones and not showAll
                    int nz6 = array.size(zF)
                    if nz6 > 0
                        for k = 0 to nz6 - 1
                            int ff = array.get(zF, k)
                            if ff >= chLi and na(array.get(zBox, k))
                                bool g6 = array.get(zGap, k)
                                array.set(zBox, k, box.new(g6 ? ff - 1 : ff - 2, array.get(zTop, k), bar_index, array.get(zBot, k), border_color=color.new(g6 ? C_GAP : C_FVG, 40), bgcolor=color.new(g6 ? C_GAP : C_FVG, 88), extend=extend.right))

// ------------------------------------------------------------------ marks
float c1Body = math.abs(close[1] - open[1])
bool spring = bar_index >= 3 and close[1] < open[1] and c1Body / open[1] >= spBody / 100 and low < low[1] and close > low[1] and math.abs(close - open) < spBodyMax / 100 * c1Body and low <= low[1] * (1 - spUnder / 100) and high <= low[1] + spReclaim / 100 * (high[1] - low[1])
bool slotOk = not sp1315 or timeframe.period != "240" or (hour(time, TZ) == 13 and minute(time, TZ) == 15)
plotshape(showSpring and spring and slotOk, "Spring", shape.triangleup, location.belowbar, color.new(#26c6da, 0), size=size.tiny, text="S", textcolor=color.new(#26c6da, 0))
plotshape(showSwings and ph, "Swing high", shape.circle, location.abovebar, color.new(C_SW, 0), offset=-pivN, size=size.tiny)
plotshape(showSwings and pl, "Swing low", shape.circle, location.belowbar, color.new(C_SW, 0), offset=-pivN, size=size.tiny)
// ZigZag swings: one line through them (its corners = the swings), redrawn on the last candle
var zzPts = array.new<chart.point>()
var polyline zzLine = na
if isZz and showSwings and swNew
    array.push(zzPts, chart.point.from_index(swNewP, swNewV))
    if array.size(zzPts) > 9000
        array.shift(zzPts)
if isZz and showSwings and barstate.islast and array.size(zzPts) > 1
    if not na(zzLine)
        polyline.delete(zzLine)
    zzLine := polyline.new(zzPts, line_color=color.new(C_SW, 10), line_width=1)
bool marked = markOn and year(time, TZ) == year(markDate, TZ) and month(time, TZ) == month(markDate, TZ) and dayofmonth(time, TZ) == dayofmonth(markDate, TZ)
bgcolor(marked ? color.new(#ffd600, 75) : na, title="Trade date")

var table tb = table.new(position.top_right, 2, 8, bgcolor=color.new(#0f172a, 15), border_color=color.new(#334155, 0), border_width=1, frame_color=color.new(#334155, 0), frame_width=1)
if showTable and barstate.islast
    string stTxt = chB < 0 ? "no CHoCH yet" : chDead ? "ended (a close under the final low)" : chBos >= 0 ? "after a BOS - no first-pullback BUY now" : "alive - waiting for price to come back to a discount zone"
    table.cell(tb, 0, 0, "Stock Blueprint", text_color=C_FIB, text_size=size.small)
    table.cell(tb, 1, 0, "CHoCH + FVG (" + (isZz ? "ZigZag" : str.tostring(pivN)) + " / " + str.tostring(downN) + ")", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 1, "CHoCH", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 1, chB < 0 ? "-" : fmtP(chLvl) + " on " + fmtT(chTime) + " (" + str.tostring(chD) + " lower highs / lows)", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 2, "Final low", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 2, chB < 0 ? "-" : fmtP(chLf) + " on " + fmtT(chLiTime), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 3, "Move high", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 3, chB < 0 ? "-" : fmtP(chH), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 4, str.tostring(fibLvl * 100) + "% line", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 4, chB < 0 or fibLvl <= 0 ? "-" : fmtP(chH - fibLvl * (chH - chLf)), text_color=C_FIB, text_size=size.small)
    table.cell(tb, 0, 5, "Status", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 5, stTxt, text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 6, "BUY signals", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 6, str.tostring(nBuys) + " on this chart · last " + lastBuy, text_color=C_BUY, text_size=size.small)
    table.cell(tb, 0, 7, "Swings", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 7, swTxt, text_color=color.white, text_size=size.small)
